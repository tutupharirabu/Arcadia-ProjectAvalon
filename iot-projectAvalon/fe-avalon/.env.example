# Salin file ini menjadi `.env` lalu isi nilai sesuai environment kamu.
# Jangan commit file `.env` yang berisi nilai asli.

# Base URL API utama (Laravel backend).
# Default jika kosong: https://arcadia-beavalon-development.up.railway.app/api/v1
VITE_API_URL=

# Base URL node server monitoring (data sensor real-time).
# Default jika kosong: https://arcadia-nodeserver-monitoring-development.up.railway.app
VITE_NODE_URL=
